# Telegram Bot API token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: maximum track length in seconds (default 1200 = 20 minutes).
# Telegram caps bot uploads at 50 MB, so very long tracks may fail.
MAX_DURATION_SECONDS=1200

# Optional: YouTube cookies to bypass "Sign in to confirm you're not a bot"
# (required when running from datacenter/cloud IPs). Export the cookie array
# with a browser extension like "Get cookies.txt LOCALLY" as JSON.
# Either provide a path to the JSON file:
# YOUTUBE_COOKIES_FILE=cookies.json
# ...or paste the JSON array inline (must be valid JSON on a single line):
# YOUTUBE_COOKIES=[{"name":"SID","value":"..."},{"name":"HSID","value":"..."}]
