# Telegram Bot API token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: maximum track length in seconds (default 1200 = 20 minutes).
# Telegram caps bot uploads at 50 MB, so very long tracks may fail.
MAX_DURATION_SECONDS=1200

# Optional: override the yt-dlp / ffmpeg binaries if they are not on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: yt-dlp YouTube player client (default: android_vr). This client
# serves formats that don't need JS signature deciphering, avoiding HTTP 403s.
# YT_DLP_PLAYER_CLIENT=android_vr

# Optional: Netscape-format cookies.txt to bypass "Sign in to confirm you're
# not a bot" on datacenter/cloud IPs. Export with a browser extension such as
# "Get cookies.txt LOCALLY".
# YOUTUBE_COOKIES_FILE=cookies.txt
